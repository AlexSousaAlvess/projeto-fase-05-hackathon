                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health-actions/citizen/{{citizenId}}",
              "host": ["{{baseUrl}}"],
              "path": ["health-actions", "citizen", "{{citizenId}}"]
            }
          },
          "response": []
        }
      ]
    },
