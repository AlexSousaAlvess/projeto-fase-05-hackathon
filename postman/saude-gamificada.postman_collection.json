              "raw": "{\n  \"citizenId\": \"{{citizenId}}\",\n  \"actionType\": \"VACCINATION\",\n  \"description\": \"Vacina contra Influenza - dose anual\",\n  \"proofDocumentUrl\": \"https://example.com/comprovantes/vacina-influenza.pdf\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/health-actions",
              "host": ["{{baseUrl}}"],
              "path": ["health-actions"]
            },
            "description": "Tipos de ação válidos (ActionType): VACCINATION (100 pts), PREVENTIVE_EXAM (150 pts)."
          },
          "response": []
